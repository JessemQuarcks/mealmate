# MealMate environment variables
# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.
#
# SECURITY: the keys previously hardcoded in source (Google Maps, Firebase) are
# already exposed and MUST be rotated in their respective consoles, then
# restricted (HTTP referrer / API restrictions) before going anywhere near prod.

# --- Database ---
# MongoDB connection string (e.g. from MongoDB Atlas)
MONGO_DB_URL=

# --- Auth (NextAuth) ---
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_ID=
GOOGLE_SECRET=

# --- Google Maps (client-side, restrict by HTTP referrer) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Paystack ---
# Public key is sent to the browser; keep the SECRET key server-side only (used later for payment verification).
NEXT_PUBLIC_PAYSTACK_KEY=
PAYSTACK_SECRET_KEY=
