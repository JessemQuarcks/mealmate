# MealMate environment variables
# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.
#
# SECURITY: the keys previously hardcoded in source (Google Maps, Firebase) are
# already exposed and MUST be rotated in their respective consoles, then
# restricted (HTTP referrer / API restrictions) before going anywhere near prod.

# --- Database ---
# MongoDB connection string (e.g. from MongoDB Atlas)
MONGO_DB_URL=

# --- Observability (optional) ---
# Webhook that warn/error logs are POSTed to (Sentry/Datadog/Logtail/Slack).
# Leave empty to log to the console only.
LOG_SINK_URL=

# --- Auth (NextAuth) ---
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_ID=
GOOGLE_SECRET=
# Comma-separated emails elevated to admin on every sign-in (full access to all
# role areas). The project owner is always included by default.
SUPERADMIN_EMAILS=

# --- Google Maps (client-side, restrict by HTTP referrer) ---
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Paystack ---
# Public key is sent to the browser to open the payment dialog.
NEXT_PUBLIC_PAYSTACK_KEY=
# SECRET key — server-side only. Used by the Phase 4 flow to verify transactions
# (POST /api/checkout/verify), issue refunds, and validate the webhook's
# x-paystack-signature. Point your Paystack dashboard webhook at:
#   {NEXTAUTH_URL}/api/payments/webhook
PAYSTACK_SECRET_KEY=

# --- Restaurant ingestion (Phase 2) ---
# Server-side key for Google Places ingestion (separate from the Maps JS key; restrict it).
GOOGLE_PLACES_API_KEY=
# Shared secret so a scheduled job can call POST /api/admin/ingest without a login.
INGEST_SECRET=
